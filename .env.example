# Copy to .env.local for local development, and set the same two names in
# Vercel → Settings → Environment Variables for production (see DEPLOYMENT.md).
#
# Leave both empty to run in on-device mode with demo data (any 4-digit PIN
# works there, nothing leaves the browser).
#
# Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
# The public "anon" / "publishable" key — safe in the browser because Row
# Level Security protects the data. NEVER put the service_role key here or in
# Vercel: it only lives inside Supabase (the pin-login Edge Function gets it
# automatically).
VITE_SUPABASE_ANON_KEY=
